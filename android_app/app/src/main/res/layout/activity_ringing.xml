<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Current Digital Clock Display -->
    <TextView
        android:id="@+id/tvRingingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="-0.02" />

    <TextView
        android:id="@+id/tvRingingDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wednesday, November 25"
        android:textColor="#9E9E9E"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <!-- Alarm Label -->
    <TextView
        android:id="@+id/tvRingingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wake up"
        android:textColor="#2196F3"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- TASK CONTAINER -->
    <FrameLayout
        android:id="@+id/taskContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp">

        <!-- 1. Math Task View -->
        <LinearLayout
            android:id="@+id/layoutMathTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMathProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solve 3 math problems (1/3)"
                android:textColor="#B0BEC5"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Math Question Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_pill"
                android:paddingVertical="16dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMathEquation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 + 17 ="
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMathInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?"
                    android:textColor="#2196F3"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Keypad -->
            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4"
                android:layout_marginTop="16dp"
                android:layout_gravity="center">

                <Button android:id="@+id/btnKey1" android:text="1" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey2" android:text="2" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey3" android:text="3" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />

                <Button android:id="@+id/btnKey4" android:text="4" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey5" android:text="5" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey6" android:text="6" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />

                <Button android:id="@+id/btnKey7" android:text="7" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey8" android:text="8" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey9" android:text="9" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />

                <Button android:id="@+id/btnKeyClear" android:text="C" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FF5252" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKey0" android:text="0" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#263238" />
                <Button android:id="@+id/btnKeyOk" android:text="OK" style="?android:attr/buttonBarStyle" android:layout_margin="4dp" android:width="70dp" android:height="48dp" android:textColor="#FFF" android:backgroundTint="#2196F3" />
            </GridLayout>
        </LinearLayout>

        <!-- 2. Shake Task View -->
        <LinearLayout
            android:id="@+id/layoutShakeTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shake your phone to dismiss"
                android:textColor="#B0BEC5"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvShakeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 20"
                android:textColor="#2196F3"
                android:textSize="44sp"
                android:textStyle="bold"
                android:layout_marginVertical="16dp" />

            <ProgressBar
                android:id="@+id/pbShakeProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="20"
                android:progress="0"
                android:progressTint="#2196F3" />
        </LinearLayout>

        <!-- 3. Instagram Reels Mission Prompt -->
        <LinearLayout
            android:id="@+id/layoutReelsTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReelsTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watch 10 Instagram Reels to dismiss"
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnOpenInstagramMission"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="Open Instagram"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#E1306C"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- 4. Task Completed Confirmation -->
        <LinearLayout
            android:id="@+id/layoutTaskCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Task Completed"
                android:textColor="#4CAF50"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Buttons: Snooze and Dismiss -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnRingingSnooze"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Snooze"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#263238"
            app:cornerRadius="16dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnRingingDismiss"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Dismiss"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            app:cornerRadius="16dp"
            android:enabled="true" />
    </LinearLayout>

</LinearLayout>
